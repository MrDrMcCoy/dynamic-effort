{
  "name": "@mrdrmccoy/dynamic-effort",
  "version": "0.1.0",
  "description": "Adjust model reasoning effort to task difficulty with a local decision model",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrDrMcCoy/dynamic-effort.git"
  },
  "type": "module",
  "main": "./dist/opencode/index.js",
  "types": "./dist/opencode/index.d.ts",
  "bin": {
    "dynamic-effort": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/opencode/index.d.ts",
      "default": "./dist/opencode/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./rpc": {
      "types": "./dist/opencode/rpc.d.ts",
      "default": "./dist/opencode/rpc.js"
    },
    "./tui": {
      "types": "./dist/opencode/tui.d.ts",
      "default": "./dist/opencode/tui.js"
    },
    "./acp": {
      "types": "./dist/acp/index.d.ts",
      "default": "./dist/acp/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "default": "./dist/pi/index.js"
    },
    "./launch": {
      "types": "./dist/launch/index.d.ts",
      "default": "./dist/launch/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "plugin",
    "reasoning-effort",
    "jev",
    "systemone"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=browser test/unit",
    "test:all": "bun test --conditions=browser test"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.5",
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.10.0",
    "solid-js": "^1.9.15",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5",
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
