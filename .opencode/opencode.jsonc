{
  "$schema": "https://opencode.ai/config.json",
  // Project-scoped plugin overrides for dynamic-effort development.
  //
  // OpenCode applies plugin arrays from all config files as ordered
  // add/remove directives (global first, then project). The "-" prefix
  // removes a plugin. The target must match the plugin's DECLARED id
  // ("smart-reasoning" in its source), not the npm package name.
  //
  // The "." package below loads this repo's own plugin for local testing.
  // It resolves against the repository root (where package.json lives), not
  // against the directory that holds this config file.
  "plugins": [
    "-smart-reasoning",
    { "package": ".", "options": { "debug": true } }
  ]
}
